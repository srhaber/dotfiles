#!/usr/bin/env bash
#
# worktree - Manage git worktrees for feature branch development
#
# Worktree Structure:
# - Main repo: Current directory (stays on main)
# - Worktrees: .worktrees/<feature>
# - Branch naming: Always use shaun/<feature> prefix
# - Directory naming: Use <feature> only (no username prefix)

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helper functions
error() {
    echo -e "${RED}Error: $*${NC}" >&2
    exit 1
}

warning() {
    echo -e "${YELLOW}Warning: $*${NC}" >&2
}

success() {
    echo -e "${GREEN}$*${NC}" >&2
}

info() {
    echo -e "${BLUE}$*${NC}" >&2
}

# Global flags (set by main)
ASSUME_YES=false
DRY_RUN=false

# Ask a yes/no question. Auto-answers yes under --yes.
confirm() {
    local prompt="$1" response
    if [[ "$ASSUME_YES" == true ]]; then
        info "$prompt [auto-yes]"
        return 0
    fi
    read -rp "$prompt [y/N] " response
    [[ "$response" =~ ^[Yy]$ ]]
}

# Run a destructive command, or describe it under --dry-run.
run() {
    if [[ "$DRY_RUN" == true ]]; then
        echo "  [dry-run] $*" >&2
        return 0
    fi
    "$@"
}

# Like run(), but silences the command's own stderr. Call sites must not add
# their own 2>/dev/null — that would swallow the [dry-run] notice too.
run_quiet() {
    if [[ "$DRY_RUN" == true ]]; then
        echo "  [dry-run] $*" >&2
        return 0
    fi
    "$@" 2>/dev/null
}

# The main repo root, even when invoked from inside a worktree.
# --show-toplevel would return the worktree's own root, which nests .worktrees/.
get_main_repo_root() {
    local common_dir
    common_dir=$(git rev-parse --git-common-dir)
    # Relative (".git") when run from the main repo root; absolute from a worktree.
    [[ "$common_dir" != /* ]] && common_dir="$(cd "$common_dir" && pwd)"
    dirname "$common_dir"
}

get_repo_name() {
    basename "$(get_main_repo_root)"
}

get_worktree_parent() {
    echo "$(get_main_repo_root)/.worktrees"
}

# Exact ref lookups. `git branch -r | grep -w` collides on hyphen suffixes:
# the pattern origin/shaun/feat matches the line origin/shaun/feat-2.
remote_branch_exists() {
    git show-ref --verify --quiet "refs/remotes/origin/$1"
}

local_branch_exists() {
    git show-ref --verify --quiet "refs/heads/$1"
}

# True if a branch is checked out in any worktree (including the main repo).
# git refuses to delete these, so prune should skip rather than fail on them.
branch_is_checked_out() {
    git worktree list --porcelain | grep -qx "branch refs/heads/$1"
}

# Preferred base for merge/ahead comparisons, remote first: local main goes
# stale because `git fetch` never fast-forwards it.
default_base_ref() {
    local ref
    for ref in origin/main origin/master; do
        git show-ref --verify --quiet "refs/remotes/$ref" && { echo "$ref"; return 0; }
    done
    for ref in main master; do
        git show-ref --verify --quiet "refs/heads/$ref" && { echo "$ref"; return 0; }
    done
    return 1
}

# Commits on $1 that are not reachable from the base ref.
unpushed_commit_count() {
    local branch="$1" base
    base=$(default_base_ref) || { echo 0; return 0; }
    git rev-list --count "${base}..${branch}" 2>/dev/null || echo 0
}

normalize_branch_name() {
    local branch="$1"
    # Add shaun/ prefix if not present
    if [[ ! "$branch" =~ ^shaun/ ]]; then
        echo "shaun/${branch}"
    else
        echo "$branch"
    fi
}

get_feature_name() {
    local branch="$1"
    # Strip shaun/ prefix to get directory name
    echo "${branch#shaun/}"
}

show_help() {
    local repo_name
    repo_name=$(get_repo_name 2>/dev/null || echo "your-repo")

    cat <<EOF
Git Worktree Manager

Commands:
  create <feature>   Create new worktree for shaun/<feature>
  list               Show all active worktrees
  remove <feature>   Remove worktree and optionally delete branch
  switch <feature>   Generate cd command to navigate to worktree
  path <feature>     Print the worktree path only (for shell functions)
  clean              Find and remove unused worktrees/branches
  prune              Prune stale worktree references
  help               Show this help message

Flags:
  -y, --yes          Skip prompts. 'clean' removes everything without
                     uncommitted changes, and reports what it skipped.
  -n, --dry-run      Print destructive commands instead of running them

Examples:
  worktree create feature-fixes
  worktree list
  worktree clean --dry-run
  worktree clean --yes
  worktree switch feature-fixes

Shell function for cd:
  wt() { cd "\$(worktree path "\$1")"; }

Notes:
  A worktree containing a .worktree_keep file is never auto-removed.
  Narration goes to stderr; 'path' and 'list' write to stdout.

Repo: ${repo_name}
Worktree location: $(get_worktree_parent 2>/dev/null || echo '<repo>/.worktrees')/<feature>
EOF
}

cmd_create() {
    local feature="$1"
    [[ -z "$feature" ]] && error "Feature name required. Usage: worktree create <feature>"

    local branch_name feature_name worktree_parent worktree_path
    branch_name=$(normalize_branch_name "$feature")
    feature_name=$(get_feature_name "$branch_name")
    worktree_parent=$(get_worktree_parent)
    worktree_path="${worktree_parent}/${feature_name}"

    # Check if worktree already exists
    if [[ -d "$worktree_path" ]]; then
        error "Worktree already exists at: $worktree_path"
    fi

    info "Fetching remote branches..."
    git fetch

    # Create parent directory if needed
    mkdir -p "$worktree_parent"

    # Local branch wins: git allows only one branch of a given name, so an
    # existing local branch is what we check out whether or not it has a remote.
    if local_branch_exists "$branch_name"; then
        info "Checking out existing local branch: ${branch_name}"
        git worktree add "$worktree_path" "$branch_name"
    elif remote_branch_exists "$branch_name"; then
        # --track -b creates a real local branch. Passing origin/<branch> as a
        # bare commit-ish instead lands the worktree in detached HEAD, which
        # also hides it from `clean` (no branch line in --porcelain output).
        info "Checking out existing remote branch: origin/${branch_name}"
        git worktree add --track -b "$branch_name" "$worktree_path" "origin/${branch_name}"
    else
        info "Creating new branch: ${branch_name}"
        git worktree add -b "$branch_name" "$worktree_path"
    fi

    success "✓ Worktree created successfully!"
    echo
    info "To switch to the worktree, run:"
    echo "  cd $worktree_path"
}

cmd_list() {
    info "Active worktrees:"
    echo
    git worktree list
}

cmd_remove() {
    local feature="$1"
    [[ -z "$feature" ]] && error "Feature name required. Usage: worktree remove <feature>"

    local branch_name feature_name worktree_parent worktree_path
    branch_name=$(normalize_branch_name "$feature")
    feature_name=$(get_feature_name "$branch_name")
    worktree_parent=$(get_worktree_parent)
    worktree_path="${worktree_parent}/${feature_name}"

    # Check if worktree exists
    if [[ ! -d "$worktree_path" ]]; then
        error "Worktree not found at: $worktree_path"
    fi

    # Respect the same opt-out marker `clean` honors
    if [[ -f "$worktree_path/.worktree_keep" ]]; then
        warning "Worktree is marked .worktree_keep"
        confirm "Remove it anyway?" || { echo "Aborted." >&2; exit 0; }
    fi

    # Check for uncommitted changes
    if [[ -n "$(git -C "$worktree_path" status --short)" ]]; then
        warning "Worktree has uncommitted changes!"
        git -C "$worktree_path" status --short >&2
        echo
        confirm "Continue with removal?" || { echo "Aborted." >&2; exit 0; }
    fi

    info "Removing worktree..."
    run git worktree remove "$worktree_path"
    run git worktree prune

    success "✓ Worktree removed: $worktree_path"

    # Ask about deleting the branch
    echo
    if confirm "Delete branch ${branch_name}?"; then
        run_quiet git branch -d "$branch_name" || {
            local ahead
            ahead=$(unpushed_commit_count "$branch_name")
            warning "Branch has unmerged commits ($ahead not reachable from $(default_base_ref || echo main))."
            if confirm "Force delete?"; then
                run git branch -D "$branch_name"
                success "✓ Branch deleted: $branch_name"
            fi
        }
    fi
}

cmd_prune() {
    info "Pruning stale worktree references..."
    run git worktree prune -v
    echo

    # Find and remove local branches with deleted remotes
    info "Checking for branches with deleted remotes..."
    local gone_branches=()
    local skipped_checked_out=()
    while IFS= read -r line; do
        local branch
        # Strip the leading "* " (current) / "+ " (checked out elsewhere) markers
        # before taking the name, or the current branch parses as literally "*".
        branch=$(echo "$line" | sed 's/^[* +]*//' | awk '{print $1}')
        [[ -z "$branch" ]] && continue
        if branch_is_checked_out "$branch"; then
            skipped_checked_out+=("$branch")
            continue
        fi
        gone_branches+=("$branch")
    done < <(git branch -vv | grep ': gone]' || true)

    if [[ ${#skipped_checked_out[@]} -gt 0 ]]; then
        echo
        warning "Skipped ${#skipped_checked_out[@]} branch(es) still checked out (use 'worktree clean'):"
        for branch in "${skipped_checked_out[@]}"; do
            echo "  - $branch" >&2
        done
    fi

    if [[ ${#gone_branches[@]} -gt 0 ]]; then
        echo
        echo "Found ${#gone_branches[@]} local branch(es) with deleted remotes:"
        for branch in "${gone_branches[@]}"; do
            echo "  - $branch"
        done
        echo

        if confirm "Delete these branches?"; then
            for branch in "${gone_branches[@]}"; do
                # Use -D to force delete since remote is already gone
                if run_quiet git branch -D "$branch"; then
                    success "  ✓ Deleted $branch"
                else
                    warning "  ✗ Failed to delete $branch"
                fi
            done
        else
            echo "Skipped branch deletion" >&2
        fi
    else
        success "✓ No branches with deleted remotes found"
    fi

    echo
    cmd_list
}

cmd_switch() {
    local feature="$1"
    [[ -z "$feature" ]] && error "Feature name required. Usage: worktree switch <feature>"

    local branch_name feature_name worktree_parent worktree_path
    branch_name=$(normalize_branch_name "$feature")
    feature_name=$(get_feature_name "$branch_name")
    worktree_parent=$(get_worktree_parent)
    worktree_path="${worktree_parent}/${feature_name}"

    if [[ ! -d "$worktree_path" ]]; then
        error "Worktree not found at: $worktree_path"
    fi

    echo "cd $worktree_path"
    echo
    info "Tip: add a shell function to cd directly:"
    info "  wt() { cd \"\$(worktree path \"\$1\")\"; }"
}

# Print only the worktree path, for shell functions and scripts.
# All narration goes to stderr, so stdout here is safe to capture.
cmd_path() {
    local feature="$1"
    [[ -z "$feature" ]] && error "Feature name required. Usage: worktree path <feature>"

    local branch_name feature_name worktree_path
    branch_name=$(normalize_branch_name "$feature")
    feature_name=$(get_feature_name "$branch_name")
    worktree_path="$(get_worktree_parent)/${feature_name}"

    [[ ! -d "$worktree_path" ]] && error "Worktree not found at: $worktree_path"
    echo "$worktree_path"
}

cmd_clean() {
    info "Analyzing worktrees and branches..."
    echo

    # Fetch and prune
    git fetch --prune

    local worktree_parent
    worktree_parent=$(get_worktree_parent)

    # Get all worktrees (excluding main)
    local worktrees=()
    local current_path=""
    local current_branch=""

    while IFS= read -r line; do
        if [[ "$line" =~ ^worktree\ (.+)$ ]]; then
            current_path="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ ^branch\ refs/heads/(.+)$ ]]; then
            current_branch="${BASH_REMATCH[1]}"

            # Skip main directory
            if [[ "$current_path" != "$(get_main_repo_root)" ]]; then
                worktrees+=("$current_path|$current_branch")
            fi

            # Reset for next worktree
            current_path=""
            current_branch=""
        fi
    done < <(git worktree list --porcelain)

    # Find merged branches. Compare against the remote base — `git fetch` above
    # refreshes origin/main but never fast-forwards local main, so a local-main
    # comparison misses branches that merged upstream.
    local base_ref
    base_ref=$(default_base_ref) || error "Could not find a main/master branch to compare against"
    info "Comparing against ${base_ref}"

    local merged_branches=()
    while IFS= read -r branch; do
        branch=$(echo "$branch" | sed 's/^[* +]*//' | xargs) # strip markers + whitespace
        [[ "$branch" == "main" || "$branch" == "master" ]] && continue
        merged_branches+=("$branch")
    done < <(git branch --merged "$base_ref" 2>/dev/null || true)

    # Find branches with deleted remotes (shaun/* branches only)
    # This catches both:
    # 1. Manually deleted remote branches
    # 2. Branches merged via rebase/squash (GitHub deletes remote after merge)
    local orphaned_branches=()
    while IFS= read -r line; do
        # Parse git branch -vv output: "* branch  hash [tracking: gone]"
        # Remove leading markers (* or +) and whitespace, then extract branch name
        local branch
        branch=$(echo "$line" | sed 's/^[* +]*//' | awk '{print $1}')
        [[ ! "$branch" =~ ^shaun/ ]] && continue
        [[ "$branch" == "main" || "$branch" == "master" ]] && continue

        if echo "$line" | grep -q "gone]"; then
            # Had an upstream, and it is gone: a genuine leftover.
            orphaned_branches+=("$branch")
        elif ! remote_branch_exists "$branch"; then
            # No remote ref and no upstream config — this is equally true of a
            # branch that was never pushed at all. Only call it orphaned when it
            # carries no commits of its own, otherwise `clean` would offer to
            # force-delete unpushed work that no warning covers.
            if [[ "$(unpushed_commit_count "$branch")" -eq 0 ]]; then
                orphaned_branches+=("$branch")
            fi
        fi
    done < <(git branch -vv)

    # Categorize worktrees
    local worktrees_to_remove=()
    local reasons=()

    # Only process if there are worktrees to check
    if [[ ${#worktrees[@]} -gt 0 ]]; then
        for wt_entry in "${worktrees[@]}"; do
            local wt_path wt_branch
            IFS='|' read -r wt_path wt_branch <<< "$wt_entry"

            local reason=""

            # Check if branch is merged
            if [[ ${#merged_branches[@]} -gt 0 ]]; then
                for merged in "${merged_branches[@]}"; do
                    if [[ "$wt_branch" == "$merged" ]]; then
                        reason="merged into ${base_ref}"
                        break
                    fi
                done
            fi

            # Check if remote was deleted
            if [[ -z "$reason" && ${#orphaned_branches[@]} -gt 0 ]]; then
                for orphaned in "${orphaned_branches[@]}"; do
                    if [[ "$wt_branch" == "$orphaned" ]]; then
                        reason="remote branch deleted"
                        break
                    fi
                done
            fi

            if [[ -n "$reason" ]]; then
                # Check for .worktree_keep file
                if [[ -f "$wt_path/.worktree_keep" ]]; then
                    info "  Skipping $wt_branch (has .worktree_keep file)"
                else
                    worktrees_to_remove+=("$wt_path|$wt_branch")
                    reasons+=("$reason")
                fi
            fi
        done
    fi

    # Display findings
    if [[ ${#worktrees_to_remove[@]} -eq 0 ]]; then
        success "✓ No worktrees need cleanup"
        return 0
    fi

    echo "Found ${#worktrees_to_remove[@]} worktree(s) to clean up:"
    echo

    # Flag entries carrying work that only exists here. Under --yes these are
    # skipped rather than force-removed, since nobody is reading the warnings.
    local risky=()
    for i in "${!worktrees_to_remove[@]}"; do
        local wt_entry="${worktrees_to_remove[$i]}"
        local reason="${reasons[$i]}"
        IFS='|' read -r wt_path wt_branch <<< "$wt_entry"

        echo "$((i+1)). $wt_branch"
        echo "   Path: $wt_path"
        echo "   Reason: $reason"

        local is_risky=false

        # Check for uncommitted changes
        if [[ -n "$(git -C "$wt_path" status --short 2>/dev/null)" ]]; then
            warning "   ⚠ Has uncommitted changes"
            is_risky=true
        fi

        # Informational only. A squash merge leaves every original commit
        # unreachable from the base, so this is nonzero for most merged
        # branches and cannot gate --yes without blocking the common case.
        # Genuinely unpushed branches are excluded earlier, at classification.
        local ahead
        ahead=$(unpushed_commit_count "$wt_branch")
        if [[ "$ahead" -gt 0 ]]; then
            echo "   $ahead commit(s) not reachable from ${base_ref} (normal after a squash merge; also true if never merged)" >&2
        fi

        risky+=("$is_risky")
        echo
    done

    # Non-interactive: remove everything that carries no unique work, and say
    # plainly what was left behind.
    if [[ "$ASSUME_YES" == true ]]; then
        local removed=0 skipped=0
        info "Removing worktrees and deleting branches (--yes)..."
        for i in "${!worktrees_to_remove[@]}"; do
            IFS='|' read -r wt_path wt_branch <<< "${worktrees_to_remove[$i]}"
            if [[ "${risky[$i]}" == true ]]; then
                warning "  - Skipping $wt_branch (uncommitted changes)"
                skipped=$((skipped + 1))
                continue
            fi
            echo "  - Removing $wt_branch..." >&2
            run_quiet git worktree remove "$wt_path" --force || true
            run_quiet git branch -D "$wt_branch" || true
            removed=$((removed + 1))
        done
        run git worktree prune
        success "✓ Cleanup complete — removed ${removed}, skipped ${skipped}"
        [[ "$skipped" -gt 0 ]] && info "Re-run without --yes to handle the skipped worktrees."
        return 0
    fi

    # Prompt for action
    cat <<EOF
What would you like to do?
1) Remove all worktrees and delete branches
2) Remove all worktrees only (keep branches)
3) Select specific worktrees to remove
4) Cancel

EOF
    read -rp "Choice [1-4]: " choice

    case "$choice" in
        1)
            info "Removing worktrees and deleting branches..."
            for wt_entry in "${worktrees_to_remove[@]}"; do
                IFS='|' read -r wt_path wt_branch <<< "$wt_entry"
                echo "  - Removing $wt_branch..."
                run_quiet git worktree remove "$wt_path" --force || true
                run_quiet git branch -D "$wt_branch" || true
            done
            run git worktree prune
            success "✓ Cleanup complete"
            ;;
        2)
            info "Removing worktrees only..."
            for wt_entry in "${worktrees_to_remove[@]}"; do
                IFS='|' read -r wt_path wt_branch <<< "$wt_entry"
                echo "  - Removing worktree for $wt_branch..."
                run_quiet git worktree remove "$wt_path" --force || true
            done
            run git worktree prune
            success "✓ Cleanup complete (branches preserved)"
            ;;
        3)
            echo
            echo "Select worktrees to remove (space-separated numbers, e.g., '1 3 5'):"
            read -rp "Selection: " selection

            # Parse selection into array
            local selected_indices=()
            for num in $selection; do
                # Validate number is in range
                if [[ "$num" =~ ^[0-9]+$ ]] && [[ "$num" -ge 1 ]] && [[ "$num" -le "${#worktrees_to_remove[@]}" ]]; then
                    selected_indices+=($((num - 1))) # Convert to 0-based index
                else
                    warning "Invalid selection: $num (skipping)"
                fi
            done

            if [[ ${#selected_indices[@]} -eq 0 ]]; then
                echo "No valid selections. Cancelled."
                exit 0
            fi

            echo
            echo "Selected worktrees:"
            for idx in "${selected_indices[@]}"; do
                local wt_entry="${worktrees_to_remove[$idx]}"
                IFS='|' read -r wt_path wt_branch <<< "$wt_entry"
                echo "  - $wt_branch"
            done
            echo
            read -rp "Delete branches too? [y/N] " delete_branches

            echo
            if [[ "$delete_branches" =~ ^[Yy]$ ]]; then
                info "Removing worktrees and deleting branches..."
                for idx in "${selected_indices[@]}"; do
                    local wt_entry="${worktrees_to_remove[$idx]}"
                    IFS='|' read -r wt_path wt_branch <<< "$wt_entry"
                    echo "  - Removing $wt_branch..."
                    run_quiet git worktree remove "$wt_path" --force || true
                    run_quiet git branch -D "$wt_branch" || true
                done
            else
                info "Removing worktrees only..."
                for idx in "${selected_indices[@]}"; do
                    local wt_entry="${worktrees_to_remove[$idx]}"
                    IFS='|' read -r wt_path wt_branch <<< "$wt_entry"
                    echo "  - Removing worktree for $wt_branch..."
                    run_quiet git worktree remove "$wt_path" --force || true
                done
            fi
            run git worktree prune
            success "✓ Cleanup complete"
            ;;
        4|*)
            echo "Cancelled"
            exit 0
            ;;
    esac
}

# Main command dispatcher
main() {
    # Check if we're in a git repo
    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        error "Not in a git repository"
    fi

    # Pull global flags out of the arg list, wherever they appear
    local args=()
    local arg
    for arg in "$@"; do
        case "$arg" in
            -y|--yes)     ASSUME_YES=true ;;
            -n|--dry-run) DRY_RUN=true ;;
            *)            args+=("$arg") ;;
        esac
    done
    set -- ${args[@]+"${args[@]}"}

    [[ "$DRY_RUN" == true ]] && info "Dry run — no changes will be made"

    local subcommand="${1:-help}"
    shift || true

    case "$subcommand" in
        create)
            cmd_create "$@"
            ;;
        list|ls)
            cmd_list
            ;;
        remove|rm)
            cmd_remove "$@"
            ;;
        prune)
            cmd_prune
            ;;
        switch|sw)
            cmd_switch "$@"
            ;;
        path)
            cmd_path "$@"
            ;;
        clean)
            cmd_clean
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            error "Unknown command: $subcommand\n\nRun 'worktree help' for usage."
            ;;
    esac
}

main "$@"
